# STDLIB: builtins
# Этот файл автоматически "берётся в себя" каждой программой:
# драйвер runc всегда загружает stdlib/builtins.rn перед пользовательским
# кодом (как общий префикс). Сейчас здесь только print — по одному
# встроенному вызову на каждый выводимый тип:
#
#   print(str)   print(int)   print(float)   print(bool)   print(char)
#
# print реализован как intrinsic: фронтенд проверяет тип аргумента,
# IR хранит Print с типом, backend раскладывает его в вызов
# print_str / print_int / print_float / print_bool / print_char
# из builtins.obj, а linker связывает их с main.
#
# Переменные объявляются как x: type = value (мутабельные),
# константы — как const x: type = value (присваивание запрещено):
#   name: str = "world"
#   n: int = 100
#   const limit: int = 10
#
# Выражения: || && == != < <= > >= + - * / % - ! ** (), полный приоритет.
# Примеры: 2 + 3 * 4, 10 % 3, 2 ** 10, (7 == 7) && true, "a" == "a".
#
# Ветвления и циклы (условия — строго bool, блоки — двоеточием + отступом):
#   if x == 10:
#       print("ten")
#   elif x > 10:
#       print("big")
#   else:
#       print("other")
#   while x < 20:
#       x = x + 1
#       if x == 10:
#           continue
#       if x > 15:
#           break
#   for i: int in 1..10:
#       print(i)
#   for j: int in 1..=3:
#       print(j)
#
# Функции с параметрами и возвратом:
#   fn add(a: int, b: int) int:
#       return a + b
#   fn main() void:
#       print(add(2, 3))
#
# Модули: import "lib.rn" / import "sub/lib.rn" / import "../lib.rn"
# (путь — относительно импортирующего файла, только верхний уровень).
#
# Точка роста: сюда позже лягут len(), input(), массивы, строки,
# if/while-хелперы, математика — без изменения архитектуры
# IR -> COFF obj -> Linker.
#
# (Файл намеренно остаётся валидным исходником языка: только комментарии,
#  никаких объявлений не требуется — print встроен в язык v0.2.)
