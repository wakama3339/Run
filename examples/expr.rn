fn main() void:
    print(2 + 3 * 4)
    print((2 + 3) * 4)
    print(10 - 4 - 3)
    print(100 / 10 / 2)
    print(10 % 3)
    print(-7 % 3)
    print(2 ** 10)
    print(2 ** 3 ** 2)
    print(-2 ** 2)
    print(2.0 ** 3)
    print(2.0 ** -2)
    print(5 == 5)
    print(5 != 6)
    print(3 < 4)
    print(4 <= 4)
    print(5 > 6)
    print(7 >= 7)
    print(1.5 < 2.5)
    print('a' == 'a')
    print('a' != 'b')
    print(true == true)
    print(true != false)
    print("abc" == "abc")
    print("abc" != "abd")
    print("abc" == "ab")
    print(true && false)
    print(true || false)
    print(!true)
    print(!(5 > 3))
    print(1 + 2 * 3 == 7 && true)
    x: int = 7
    print(x * x - 4)
    const k: int = 3
    print(k ** k)
