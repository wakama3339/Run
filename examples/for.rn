fn main() void:
    for i: int in 1..5:
        print(i)
    print("---")
    for j: int in 1..=3:
        print(j)
    print("---")
    n: int = 0
    while n < 5:
        print(n)
        n = n + 1
    print("---")
    for a: int in 0..3:
        for b: int in 0..=2:
            print(a * 10 + b)
    print("---")
    s: int = 0
    for k: int in 1..=10:
        if k == 5:
            print("five")
        s = s + k
    print(s)
    print("---")
    for e: int in 5..5:
        print("never")
    print("done")
    print("---")
    for i: int in 0..10:
        if i % 2 == 0:
            continue
        if i > 7:
            break
        print(i)
    print("---")
    n2: int = 0
    while true:
        n2 = n2 + 1
        if n2 % 3 == 0:
            continue
        if n2 >= 7:
            break
        print(n2 * 10)
